# Telegram bot token from @BotFather
BOT_TOKEN=123456:your-telegram-bot-token

# Comma-separated Telegram user ids allowed to use the bot
ALLOWED_IDS=111111111,222222222

# Prometheus/Alertmanager endpoints (behind your own token-auth reverse-proxy path)
AM_ALERTS_URL=https://your-domain/ambot/api/v2/alerts
PROM_QUERY_URL=https://your-domain/prombot/api/v1/query
AM_TOKEN=change-me
PROM_TOKEN=change-me

# Node names as used in the "server" label on your Prometheus targets
SERVERS_ORDER=srv1,srv2,srv3

ALERT_POLL_SECONDS=45
ALERT_HTTP_TIMEOUT=15
